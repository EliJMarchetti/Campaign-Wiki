# Local file-backed development. No cloud service is required for the manual workflow.
CAMPAIGN_WIKI_DATA_PATH=./data/campaign-wiki.json

# Optional OpenAI provider. Without this, use prompt packages or the mock provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_DAILY_BUDGET_USD=5

# Supabase production/local CLI configuration. The app runs without these in file-backed mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hard safety default: generated material is output only unless a GM signs a ruling.
CAMPAIGN_WIKI_REQUIRE_HUMAN_RULINGS=true
